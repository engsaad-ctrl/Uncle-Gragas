{
  "name": "lol-helper",
  "version": "0.1.0",
  "private": true,
  "description": "مساعد شخصي لـ League of Legends",
  "author": "engsaad",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "probe": "node scripts/probe.mjs",
    "release:win": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "electron-updater": "6.8.10",
    "hash-wasm": "4.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.engsaad.unclegragas",
    "productName": "Uncle Gragas",
    "files": [
      "dist/**/*",
      "static/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Uncle-Gragas-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "engsaad-ctrl",
      "repo": "Uncle-Gragas",
      "releaseType": "release"
    }
  }
}
